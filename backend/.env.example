# Database
DATABASE_URL="postgresql://localhost:5432/spotify_helper"

# Spotify Configuration
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="http://localhost:3001/spotify/callback"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Owner account — created on every boot if missing, and always repaired to
# admin + active. This account can never be demoted, deactivated or deleted
# from the admin UI, so it is the way back in if anything goes wrong.
ADMIN_EMAIL="you@example.com"
# Optional. Leave empty and a password is generated and printed to the backend
# log on first boot. Either way it must be changed on first login.
ADMIN_INITIAL_PASSWORD=""

# Redis (lyrics fetch queue). Optional — without it lyrics are fetched
# in-process. On Railway, reference the Redis service: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=""
# ...or instead of REDIS_URL:
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Server Configuration
PORT=3001
NODE_ENV="development"
# Required in production — main.ts uses it as the only allowed CORS origin.
FRONTEND_URL=""